  <script>
    const form = document.getElementById('glp1Calculator');
    const resetBtn = document.getElementById('resetCalculator');
    const resultsSection = document.getElementById('resultsSection');
    const startDateField = document.getElementById('startDate');

    const today = new Date();
    startDateField.value = today.toISOString().split('T')[0];

    function addMonths(date, months) {
      const d = new Date(date);
      d.setMonth(d.getMonth() + months);
      return d;
    }

    function addWeeks(date, weeks) {
      const d = new Date(date);
      d.setDate(d.getDate() + Math.round(weeks * 7));
      return d;
    }

    function formatDate(date) {
      return date.toLocaleDateString('en-US', {
        month: 'long',
        day: 'numeric',
        year: 'numeric'
      });
    }

    function round1(num) {
      return Math.round(num * 10) / 10;
    }

    function calculateBMI(weightLbs, heightInches) {
      return (weightLbs / (heightInches * heightInches)) * 703;
    }

    function paceAdjustments(activity, glp1Status, weeksOnProgram) {
      let low = 1.0;
      let high = 2.0;

      if (activity === 'light') {
        low += 0.1;
        high += 0.1;
      }
      if (activity === 'moderate') {
        low += 0.2;
        high += 0.2;
      }
      if (activity === 'high') {
        low += 0.3;
        high += 0.3;
      }

      if (glp1Status === 'not-started') {
        low -= 0.25;
        high -= 0.25;
      }
      if (glp1Status === 'starting-soon') {
        low -= 0.1;
        high -= 0.1;
      }
      if (glp1Status === 'current') {
        low += 0.1;
        high += 0.1;
      }

      if (Number(weeksOnProgram) >= 8) {
        low += 0.1;
        high += 0.15;
      }

      low = Math.max(0.5, low);
      high = Math.max(1.0, high);

      return { low, high };
    }

    function weightRangeForMonths(months, weeklyLow, weeklyHigh, poundsToLose) {
      const lowLoss = Math.min(poundsToLose, round1(months * 4.345 * weeklyLow));
      const highLoss = Math.min(poundsToLose, round1(months * 4.345 * weeklyHigh));
      return { lowLoss, highLoss };
    }

    function milestoneDateByLossNeeded(lossNeeded, weeklyPace, startDate) {
      if (lossNeeded <= 0 || weeklyPace <= 0) return '-';
      const weeks = lossNeeded / weeklyPace;
      return formatDate(addWeeks(startDate, weeks));
    }

    form.addEventListener('submit', function(e) {
      e.preventDefault();

      const currentWeight = parseFloat(document.getElementById('currentWeight').value);
      const goalWeight = parseFloat(document.getElementById('goalWeight').value);
      const heightFeet = parseFloat(document.getElementById('heightFeet').value);
      const heightInchesExtra = parseFloat(document.getElementById('heightInches').value);
      const age = parseFloat(document.getElementById('age').value);
      const sex = document.getElementById('sex').value;
      const activity = document.getElementById('activity').value;
      const glp1Status = document.getElementById('glp1Status').value;
      const weeksOnProgram = parseFloat(document.getElementById('weeksOnProgram').value || 0);
      const proteinGoal = parseFloat(document.getElementById('proteinGoal').value || 0);
      const waterGoal = parseFloat(document.getElementById('waterGoal').value || 0);
      const startDate = new Date(document.getElementById('startDate').value);

      if (!currentWeight || !goalWeight || !heightFeet && heightFeet !== 0 || !age || isNaN(startDate.getTime())) {
        return;
      }

      if (goalWeight >= currentWeight) {
        alert('Goal weight must be lower than current weight.');
        return;
      }

      const totalHeightInches = (heightFeet * 12) + heightInchesExtra;
      const poundsToLose = round1(currentWeight - goalWeight);
      const currentBMI = round1(calculateBMI(currentWeight, totalHeightInches));
      const goalBMI = round1(calculateBMI(goalWeight, totalHeightInches));
      const percentLoss = round1((poundsToLose / currentWeight) * 100);
      const tenPercentWeight = round1(currentWeight * 0.10);

      const pace = paceAdjustments(activity, glp1Status, weeksOnProgram);
      const slowWeekly = pace.low;
      const fastWeekly = pace.high;

      const month1 = weightRangeForMonths(1, slowWeekly, fastWeekly, poundsToLose);
      const month3 = weightRangeForMonths(3, slowWeekly, fastWeekly, poundsToLose);
      const month6 = weightRangeForMonths(6, slowWeekly, fastWeekly, poundsToLose);
      const month12 = weightRangeForMonths(12, slowWeekly, fastWeekly, poundsToLose);

      const maxMonths = round1(poundsToLose / slowWeekly / 4.345);
      const minMonths = round1(poundsToLose / fastWeekly / 4.345);

      const goalFastDate = formatDate(addWeeks(startDate, poundsToLose / fastWeekly));
      const goalSlowDate = formatDate(addWeeks(startDate, poundsToLose / slowWeekly));

      const milestone5 = milestoneDateByLossNeeded(5, fastWeekly, startDate);
      const milestone10 = milestoneDateByLossNeeded(10, fastWeekly, startDate);
      const milestone10Percent = milestoneDateByLossNeeded(tenPercentWeight, fastWeekly, startDate);
      const milestoneGoal = goalFastDate + ' to ' + goalSlowDate;

      document.getElementById('summaryHeadline').textContent = 'Your projected GLP-1 weight loss timeline';
      document.getElementById('summaryText').textContent =
        'You want to lose ' + poundsToLose + ' lbs. Based on a steady GLP-1 supported pace, your goal could fall within about ' +
        minMonths + ' to ' + maxMonths + ' months, with a likely goal window between ' + goalFastDate + ' and ' + goalSlowDate + '.';

      document.getElementById('poundsToLose').textContent = poundsToLose + ' lbs';
      document.getElementById('goalWindow').textContent = minMonths + ' to ' + maxMonths + ' months';
      document.getElementById('bmiChange').textContent = currentBMI + ' to ' + goalBMI;
      document.getElementById('tenPercentLoss').textContent = tenPercentWeight + ' lbs';
      document.getElementById('tenPercentDate').textContent = 'Projected around ' + milestone10Percent;

      document.getElementById('month1Range').textContent = month1.lowLoss + ' to ' + month1.highLoss + ' lbs';
      document.getElementById('month3Range').textContent = month3.lowLoss + ' to ' + month3.highLoss + ' lbs';
      document.getElementById('month6Range').textContent = month6.lowLoss + ' to ' + month6.highLoss + ' lbs';
      document.getElementById('month12Range').textContent = month12.lowLoss + ' to ' + month12.highLoss + ' lbs';

      document.getElementById('milestone5').textContent = milestone5;
      document.getElementById('milestone10').textContent = milestone10;
      document.getElementById('milestone10Percent').textContent = milestone10Percent;
      document.getElementById('milestoneGoal').textContent = milestoneGoal;

      const notes = [];

      notes.push('Losing 10% of body weight would mean about ' + tenPercentWeight + ' lbs for you. This is a major benchmark many people focus on.');
      notes.push('Your BMI is estimated to move from ' + currentBMI + ' to ' + goalBMI + ' if you reach your goal weight.');
      notes.push('Your total target loss is about ' + percentLoss + '% of your current body weight.');
      notes.push('Your estimated weekly pace range in this calculator is about ' + slowWeekly + ' to ' + fastWeekly + ' lbs per week.');
      
      if (proteinGoal > 0) {
        notes.push('Your selected protein goal is ' + proteinGoal + ' grams per day. Protein intake matters during weight loss to help protect lean mass.');
      }

      if (waterGoal > 0) {
        notes.push('Your selected water goal is ' + waterGoal + ' oz per day. Staying hydrated matters during a GLP-1 program.');
      }

      if (age >= 50) {
        notes.push('As people get older, preserving muscle becomes more important. Protein intake and resistance training deserve extra attention.');
      }

      if (sex === 'female') {
        notes.push('Hormonal shifts, body composition, and lifestyle patterns can affect pace. Consistency matters more than short bursts of progress.');
      } else {
        notes.push('Changes in body composition and activity can shift weight loss pace. Long-term consistency still drives the result.');
      }

      const notesList = document.getElementById('resultsNotes');
      notesList.innerHTML = notes.map(note => '<li>' + note + '</li>').join('');

      resultsSection.style.display = 'block';
      resultsSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });

    resetBtn.addEventListener('click', function() {
      form.reset();
      startDateField.value = today.toISOString().split('T')[0];
      resultsSection.style.display = 'none';
    });
  </script>
</body>
</html>
