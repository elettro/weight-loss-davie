      font-weight: 700;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      background: rgba(25, 86, 191, 0.10);
      color: #1956bf;
    }

    .hero-copy h1 {
      font-size: clamp(2.2rem, 5vw, 4.2rem);
      line-height: 1.05;
      margin: 0 0 18px;
    }

    .hero-copy p {
      font-size: 1.08rem;
      line-height: 1.7;
      max-width: 700px;
      margin: 0 0 18px;
    }

    .hero-points {
      display: grid;
      gap: 12px;
      margin-top: 24px;
    }

