  <link rel="stylesheet" href="/css/style.css" />

  <style>
    .calculator-hero {
      padding: 110px 20px 70px;
      position: relative;
      overflow: hidden;
    }

    .calculator-hero .section-inner {
      max-width: 1200px;
      margin: 0 auto;
      display: grid;
      grid-template-columns: 1.1fr 0.9fr;
      gap: 36px;
      align-items: center;
    }

    .eyebrow {
      display: inline-block;
